// Prisma Schema for Gift Girl Marketplace Infrastructure & Auth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System Infrastructure Metadata / Audit placeholder for database health validation
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("OK")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_health")
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  LOCKED
  DISABLED
}

enum UserRole {
  CUSTOMER
  SELLER
  SELLER_STAFF
  DELIVERY_AGENT
  ADMIN
  SUPER_ADMIN
}

enum VerificationType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

enum SecurityEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  TOKEN_REUSE_DETECTED
  ACCOUNT_LOCKED
  VERIFICATION_SUCCESS
  VERIFICATION_FAILED
  PROFILE_UPDATE
  ADDRESS_CREATE
  ADDRESS_UPDATE
  ADDRESS_DELETE
  ROLE_ASSIGNED
  PERMISSION_ASSIGNED
  ACCOUNT_STATUS_CHANGE
  SELLER_APPLICATION_CREATED
  SELLER_APPLICATION_UPDATED
  SELLER_APPROVED
  SELLER_REJECTED
  SELLER_SUSPENDED
  SELLER_ACTIVATED
  SELLER_DISABLED
  STORE_CREATED
  STORE_UPDATED
  STORE_SUBMITTED
  STORE_APPROVED
  STORE_SUSPENDED
  STORE_ACTIVATED
  SELLER_STAFF_ADDED
  SELLER_STAFF_REMOVED
  SELLER_STAFF_UPDATED
  SELLER_DOCUMENT_UPLOADED
  SELLER_DOCUMENT_REVIEWED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  CATEGORY_ACTIVATED
  CATEGORY_DEACTIVATED
  BRAND_CREATED
  BRAND_UPDATED
  BRAND_DELETED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_SUBMITTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_PUBLISHED
  PRODUCT_ARCHIVED
  PRODUCT_DELETED
  PRODUCT_VARIANT_CREATED
  PRODUCT_VARIANT_UPDATED
  PRODUCT_VARIANT_DELETED
  PRODUCT_MEDIA_ADDED
  PRODUCT_MEDIA_UPDATED
  PRODUCT_MEDIA_DELETED
  INVENTORY_INITIALIZED
  INVENTORY_ADJUSTED
  INVENTORY_RESERVATION_CREATED
  INVENTORY_RESERVATION_RELEASED
  INVENTORY_RESERVATION_EXPIRED
  INVENTORY_RESERVATION_CONSUMED
  INVENTORY_STOCK_OUT
  INVENTORY_LOW_STOCK
  INVENTORY_SETTINGS_UPDATED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  DISABLED
}

enum SellerVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  DISABLED
  CLOSED
}

enum SellerDocumentType {
  BUSINESS_LICENSE
  IDENTITY_DOCUMENT
  TAX_DOCUMENT
  BANK_DOCUMENT
}

enum SellerDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SellerStaffStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model User {
  id                  String               @id @default(uuid())
  email               String?              @unique
  phone               String?              @unique
  passwordHash        String
  status              UserStatus           @default(PENDING_VERIFICATION)
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  role                UserRole             @default(CUSTOMER)
  failedLoginAttempts Int                  @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  profile             UserProfile?
  addresses           UserAddress[]
  preference          UserPreference?
  roleAssignments     UserRoleAssignment[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  securityAuditEvents SecurityAuditEvent[]
  seller              Seller?
  sellerApplications  SellerApplication[]
  staffRoles          SellerStaff[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  dateOfBirth DateTime?
  gender      String?
  locale      String    @default("en")
  timezone    String    @default("UTC")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("user_profiles")
}

model UserAddress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String   @default("Home")
  recipientName    String
  phone            String
  country          String   @default("Egypt")
  governorateState String
  city             String
  district         String?
  street           String
  building         String?
  apartment        String?
  floor            String?
  postalCode       String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_addresses")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language           String   @default("ar")
  currency           String   @default("EGP")
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  smsNotifications   Boolean  @default(true)
  marketingConsent   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("user_preferences")
}

model Role {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  description         String?
  isSystem            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  rolePermissions     RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  familyId         String
  deviceInfo       String?
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  revokeReason     String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([refreshTokenHash])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  type      VerificationType
  expiresAt DateTime
  isUsed    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("verification_tokens")
}

model SecurityAuditEvent {
  id        String            @id @default(uuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([event])
  @@map("security_audit_events")
}

model Seller {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  legalName          String?
  description        String?
  phone              String
  email              String
  country            String                   @default("Egypt")
  governorateState   String
  city               String
  address            String
  status             SellerStatus             @default(PENDING)
  verificationStatus SellerVerificationStatus @default(PENDING)
  rejectionReason    String?
  approvedAt         DateTime?
  suspendedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  applications       SellerApplication[]
  documents          SellerDocument[]
  stores             Store[]
  staff              SellerStaff[]

  @@index([userId])
  @@index([status])
  @@index([verificationStatus])
  @@map("sellers")
}

model SellerApplication {
  id                 String                  @id @default(uuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId           String?
  seller             Seller?                 @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  businessName       String
  businessType       String?
  taxNumber          String?
  commercialRegister String?
  contactPhone       String
  contactEmail       String
  notes              String?
  status             SellerApplicationStatus @default(SUBMITTED)
  rejectionReason    String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([userId])
  @@index([sellerId])
  @@index([status])
  @@map("seller_applications")
}

model SellerDocument {
  id               String               @id @default(uuid())
  sellerId         String
  seller           Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type             SellerDocumentType
  fileReference    String
  fileName         String?
  status           SellerDocumentStatus @default(PENDING)
  rejectionReason  String?
  uploadedAt       DateTime             @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?

  @@index([sellerId])
  @@index([status])
  @@map("seller_documents")
}

model Store {
  id               String      @id @default(uuid())
  sellerId         String
  seller           Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name             String
  slug             String      @unique
  description      String?
  logoUrl          String?
  bannerUrl        String?
  status           StoreStatus @default(DRAFT)
  contactEmail     String
  contactPhone     String
  country          String      @default("Egypt")
  governorateState String
  city             String
  address          String?
  returnPolicy     String?
  shippingPolicy   String?
  rejectionReason  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  products         Product[]

  @@index([sellerId])
  @@index([status])
  @@index([slug])
  @@map("stores")
}

model SellerStaff {
  id        String            @id @default(uuid())
  sellerId  String
  seller    Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String            @default("STAFF")
  status    SellerStaffStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sellerId, userId])
  @@index([sellerId])
  @@index([userId])
  @@map("seller_staff")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum BrandStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum ProductVisibility {
  PUBLIC
  PRIVATE
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]     @relation("CategoryHierarchy")
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  products    Product[]

  @@index([parentId])
  @@index([status])
  @@index([slug])
  @@map("categories")
}

model Brand {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  logoUrl     String?
  description String?
  status      BrandStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products    Product[]

  @@index([status])
  @@index([slug])
  @@map("brands")
}

model Product {
  id               String            @id @default(uuid())
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId          String?
  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name             String
  slug             String
  shortDescription String?
  description      String?
  status           ProductStatus     @default(DRAFT)
  visibility       ProductVisibility @default(PUBLIC)
  basePrice        Decimal           @db.Decimal(10, 2)
  compareAtPrice   Decimal?          @db.Decimal(10, 2)
  currency         String            @default("EGP")
  rejectionReason  String?
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  options          ProductOption[]
  variants         ProductVariant[]
  attributes       ProductAttribute[]
  media            ProductMedia[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([visibility])
  @@index([status, visibility])
  @@index([createdAt])
  @@map("products")
}

model ProductOption {
  id        String               @id @default(uuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  values    ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id            String                      @id @default(uuid())
  optionId      String
  option        ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value         String
  position      Int                         @default(0)
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  variantValues ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id                     String                      @id @default(uuid())
  productId              String
  product                Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                    String                      @unique
  price                  Decimal?                    @db.Decimal(10, 2)
  compareAtPrice         Decimal?                    @db.Decimal(10, 2)
  optionCombinationHash String?
  isDefault              Boolean                     @default(false)
  status                 String                      @default("ACTIVE")
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  optionValues           ProductVariantOptionValue[]
  inventory              Inventory?

  @@unique([productId, optionCombinationHash])
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String

  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@id([variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
  @@map("product_variant_option_values")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId])
  @@map("product_attributes")
}

model ProductMedia {
  id        String           @id @default(uuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductMediaType @default(IMAGE)
  url       String
  altText   String?
  sortOrder Int              @default(0)
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([productId])
  @@map("product_media")
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISABLED
}

enum InventoryMovementType {
  INITIAL_STOCK
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  RETURN
  DAMAGE
  LOSS
  MANUAL_CORRECTION
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  EXPIRED
  CONSUMED
  CANCELLED
}

model Inventory {
  id                String          @id @default(uuid())
  variantId         String          @unique
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHandQuantity    Int             @default(0)
  reservedQuantity  Int             @default(0)
  lowStockThreshold Int             @default(10)
  version           Int             @default(1)
  status            InventoryStatus @default(OUT_OF_STOCK)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  movements         InventoryMovement[]
  reservations      InventoryReservation[]

  @@index([status])
  @@index([variantId])
  @@map("inventories")
}

model InventoryMovement {
  id             String                @id @default(uuid())
  inventoryId    String
  inventory      Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type           InventoryMovementType
  quantity       Int
  beforeQuantity Int
  afterQuantity  Int
  reason         String?
  referenceType  String?
  referenceId    String?
  idempotencyKey String?               @unique
  performedBy    String?
  createdAt      DateTime              @default(now())

  @@index([inventoryId])
  @@index([createdAt])
  @@index([type])
  @@index([idempotencyKey])
  @@map("inventory_movements")
}

model InventoryReservation {
  id             String            @id @default(uuid())
  inventoryId    String
  inventory      Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  quantity       Int
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime
  referenceType  String?
  referenceId    String?
  idempotencyKey String?           @unique
  createdBy      String?
  releasedAt     DateTime?
  consumedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([inventoryId])
  @@index([status])
  @@index([expiresAt])
  @@index([idempotencyKey])
  @@map("inventory_reservations")
}
