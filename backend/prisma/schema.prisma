// Prisma Schema for Gift Girl Marketplace Infrastructure & Auth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// System Infrastructure Metadata / Audit placeholder for database health validation
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("OK")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_health")
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  LOCKED
  DISABLED
}

enum UserRole {
  CUSTOMER
  SELLER
  SELLER_STAFF
  DELIVERY_AGENT
  ADMIN
  SUPER_ADMIN
}

enum VerificationType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
}

enum SecurityEventType {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
  TOKEN_REUSE_DETECTED
  ACCOUNT_LOCKED
  VERIFICATION_SUCCESS
  VERIFICATION_FAILED
  PROFILE_UPDATE
  ADDRESS_CREATE
  ADDRESS_UPDATE
  ADDRESS_DELETE
  ROLE_ASSIGNED
  PERMISSION_ASSIGNED
  ACCOUNT_STATUS_CHANGE
  SELLER_APPLICATION_CREATED
  SELLER_APPLICATION_UPDATED
  SELLER_APPROVED
  SELLER_REJECTED
  SELLER_SUSPENDED
  SELLER_ACTIVATED
  SELLER_DISABLED
  STORE_CREATED
  STORE_UPDATED
  STORE_SUBMITTED
  STORE_APPROVED
  STORE_SUSPENDED
  STORE_ACTIVATED
  SELLER_STAFF_ADDED
  SELLER_STAFF_REMOVED
  SELLER_STAFF_UPDATED
  SELLER_DOCUMENT_UPLOADED
  SELLER_DOCUMENT_REVIEWED
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  DISABLED
}

enum SellerVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum SellerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  DISABLED
  CLOSED
}

enum SellerDocumentType {
  BUSINESS_LICENSE
  IDENTITY_DOCUMENT
  TAX_DOCUMENT
  BANK_DOCUMENT
}

enum SellerDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SellerStaffStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model User {
  id                  String               @id @default(uuid())
  email               String?              @unique
  phone               String?              @unique
  passwordHash        String
  status              UserStatus           @default(PENDING_VERIFICATION)
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  role                UserRole             @default(CUSTOMER)
  failedLoginAttempts Int                  @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  profile             UserProfile?
  addresses           UserAddress[]
  preference          UserPreference?
  roleAssignments     UserRoleAssignment[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  securityAuditEvents SecurityAuditEvent[]
  seller              Seller?
  sellerApplications  SellerApplication[]
  staffRoles          SellerStaff[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  dateOfBirth DateTime?
  gender      String?
  locale      String    @default("en")
  timezone    String    @default("UTC")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("user_profiles")
}

model UserAddress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String   @default("Home")
  recipientName    String
  phone            String
  country          String   @default("Egypt")
  governorateState String
  city             String
  district         String?
  street           String
  building         String?
  apartment        String?
  floor            String?
  postalCode       String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_addresses")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language           String   @default("ar")
  currency           String   @default("EGP")
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  smsNotifications   Boolean  @default(true)
  marketingConsent   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("user_preferences")
}

model Role {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  description         String?
  isSystem            Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  rolePermissions     RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  resource        String
  action          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  familyId         String
  deviceInfo       String?
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean   @default(false)
  revokedAt        DateTime?
  revokeReason     String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([familyId])
  @@index([refreshTokenHash])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model VerificationToken {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  type      VerificationType
  expiresAt DateTime
  isUsed    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("verification_tokens")
}

model SecurityAuditEvent {
  id        String            @id @default(uuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([event])
  @@map("security_audit_events")
}

model Seller {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  legalName          String?
  description        String?
  phone              String
  email              String
  country            String                   @default("Egypt")
  governorateState   String
  city               String
  address            String
  status             SellerStatus             @default(PENDING)
  verificationStatus SellerVerificationStatus @default(PENDING)
  rejectionReason    String?
  approvedAt         DateTime?
  suspendedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  applications       SellerApplication[]
  documents          SellerDocument[]
  stores             Store[]
  staff              SellerStaff[]

  @@index([userId])
  @@index([status])
  @@index([verificationStatus])
  @@map("sellers")
}

model SellerApplication {
  id                 String                  @id @default(uuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId           String?
  seller             Seller?                 @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  businessName       String
  businessType       String?
  taxNumber          String?
  commercialRegister String?
  contactPhone       String
  contactEmail       String
  notes              String?
  status             SellerApplicationStatus @default(SUBMITTED)
  rejectionReason    String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([userId])
  @@index([sellerId])
  @@index([status])
  @@map("seller_applications")
}

model SellerDocument {
  id               String               @id @default(uuid())
  sellerId         String
  seller           Seller               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type             SellerDocumentType
  fileReference    String
  fileName         String?
  status           SellerDocumentStatus @default(PENDING)
  rejectionReason  String?
  uploadedAt       DateTime             @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?

  @@index([sellerId])
  @@index([status])
  @@map("seller_documents")
}

model Store {
  id               String      @id @default(uuid())
  sellerId         String
  seller           Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name             String
  slug             String      @unique
  description      String?
  logoUrl          String?
  bannerUrl        String?
  status           StoreStatus @default(DRAFT)
  contactEmail     String
  contactPhone     String
  country          String      @default("Egypt")
  governorateState String
  city             String
  address          String?
  returnPolicy     String?
  shippingPolicy   String?
  rejectionReason  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([slug])
  @@map("stores")
}

model SellerStaff {
  id        String            @id @default(uuid())
  sellerId  String
  seller    Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String            @default("STAFF")
  status    SellerStaffStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([sellerId, userId])
  @@index([sellerId])
  @@index([userId])
  @@map("seller_staff")
}
