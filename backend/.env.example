# Application Environment Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gift_girl_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Logging
LOG_LEVEL=info

# Swagger API Documentation
SWAGGER_ENABLED=true

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_production_123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_production_987654321
JWT_REFRESH_EXPIRES_IN=7d
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOGIN_MAX=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
VERIFICATION_EXPIRATION_HOURS=24
PASSWORD_RESET_EXPIRATION_MINUTES=30
